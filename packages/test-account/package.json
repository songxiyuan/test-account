{
  "name": "@dsh-test-account/test-account",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 测试账号登录态管理：账号元数据注册表 + 右侧栏面板 + 当前 Session 的 Playwright storageState 桥",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
